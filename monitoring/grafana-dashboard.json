{
  "title": "HCP and Smokemap monitoring",
  "uid": "smokemap-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Collector age (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - smokemap_collector_timestamp_seconds{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Source success (0 = failed)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_source_success{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Source age (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - smokemap_source_timestamp_seconds{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Container running",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_container_running{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container health (see configured flag)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_container_health{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_container_restarts_total{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue oldest age (seconds)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_hcp_queue_oldest_age_seconds{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Expired leases (120 second grace)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_hcp_expired_leases{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures in last hour",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_hcp_failures_last_hour{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Expected approval waits (informational)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smokemap_hcp_approval_waits{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Backup verified age (NO DATA = OPEN)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - smokemap_backup_verified_timestamp_seconds{job=\"smokemap-monitoring\"}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Active monitoring alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}"
        }
      ]
    }
  ]
}
