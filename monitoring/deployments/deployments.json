    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Deployment health\n20 services · 4 deployments · gray = UNKNOWN."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "title": "Expected services",
      "type": "stat",
      "description": "Full inventory: development 5, Quick staging 7, local staging 6, web-checker production 2. Selection narrows these totals; inventory alert catches omitted expectations.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "pluginVersion": "11.3.1",
      "targets": [
        {
          "refId": "A",
          "expr": "count(deployment_expected{job=\"smokemap-monitoring\",host=\"jenkins\",application=~\"$application\",environment=~\"$environment\",deployment=~\"$deployment\"} and on(job,instance) (deployment_collector_fresh == 1))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{deployment}} / {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "UNKNOWN",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        },
        "spanNulls": false,
        "insertNulls": false
      },
