{
  "uid": "jenkins-deployments",
  "title": "Jenkins deployments",
  "schemaVersion": 40,
  "version": 1,
  "tags": [
    "deployments",
    "jenkins"
  ],
  "timezone": "browser",
  "refresh": "30s",
