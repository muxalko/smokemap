          "expr": "(count(deployment_service_state{job=\"smokemap-monitoring\",host=\"jenkins\",application=~\"$application\",environment=~\"$environment\",deployment=~\"$deployment\"} >= 2) or (sum(deployment_expected{job=\"smokemap-monitoring\",host=\"jenkins\",application=~\"$application\",environment=~\"$environment\",deployment=~\"$deployment\"} and on(job,instance) (deployment_collector_fresh == 1)) * 0))",
