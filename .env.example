# Safe local-development defaults. Copy to .env only when overrides are needed.
POSTGRES_DB=smokemap
POSTGRES_USER=smokemap
POSTGRES_PASSWORD=smokemap
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=smokemap-images
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DJANGO_SECRET_KEY=local-only-django-secret-change-me
NEXTAUTH_SECRET=local-only-nextauth-secret-change-me
AWS_REGION=us-east-1

FRONTEND_PORT=3000
BACKEND_PORT=8000
BACKEND_INTERNAL_URL=http://backend:8000
GRAPHQL_INTERNAL_ENDPOINT=http://backend:8000/graphql/
LOG_LEVEL=info
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
