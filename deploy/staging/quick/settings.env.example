# init leaves origins empty; connectors records the two discovered HTTPS origins.
COMPOSE_PROJECT_NAME=smokemap-quick-staging
STAGING_SECRETS_DIR=/var/lib/smokemap-quick-staging/secrets
STAGING_SECRET_GID=1000

STAGING_APP_URL=
STAGING_MEDIA_URL=

POSTGRES_DB=smokemap_quick_staging
POSTGRES_USER=smokemap_quick_staging
MINIO_BUCKET=smokemap-quick-staging-public
MINIO_PRIVATE_MEDIA_BUCKET=smokemap-quick-staging-private
AWS_REGION=us-east-1
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_CLEANUP_INTERVAL_SECONDS=300
LOG_LEVEL=info
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:9b49eed8f62806d5d45ddf59ecefb5710429598ea6d3fcccd2af938f621b2b07
