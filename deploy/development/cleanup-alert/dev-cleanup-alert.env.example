# Opt-in DEVELOPMENT media-cleanup email monitor settings.
# Copy to ~/.config/smokemap/dev-cleanup-alert.env with mode 0600 and replace
# every REPLACE_ME. The monitor refuses to run while any placeholder remains.
# Never put a password in this file; use CLEANUP_ALERT_SMTP_PASSWORD_FILE.

# Compose project name of the active DEVELOPMENT release (docker compose ls).
CLEANUP_ALERT_COMPOSE_PROJECT=REPLACE_ME
# Absolute Docker CLI path; only read-only ps/inspect queries are issued.
CLEANUP_ALERT_DOCKER=/usr/bin/docker
CLEANUP_ALERT_DOCKER_TIMEOUT_SECONDS=15

# SMTP relay. starttls (default) and tls verify the server certificate with the
# system trust store. none is accepted only for localhost/127.0.0.1/::1 without
# credentials.
CLEANUP_ALERT_SMTP_HOST=REPLACE_ME
CLEANUP_ALERT_SMTP_PORT=587
CLEANUP_ALERT_SMTP_SECURITY=starttls
CLEANUP_ALERT_SMTP_TIMEOUT_SECONDS=20
# Leave both empty for an unauthenticated relay. With a username, the password
# file must be an absolute path to a UID-owned regular file without group/other
# access, or empty when the unit provides LoadCredential=smtp-password:...
CLEANUP_ALERT_SMTP_USERNAME=
CLEANUP_ALERT_SMTP_PASSWORD_FILE=

# Plain sender address and comma-separated recipients without spaces (at most 10).
CLEANUP_ALERT_FROM=REPLACE_ME
CLEANUP_ALERT_TO=REPLACE_ME

# Consecutive non-healthy checks before the first alert (1-100).
CLEANUP_ALERT_FAILURE_THRESHOLD=2
# Reminder period while still failing: 0 disables, otherwise 60-2592000 seconds.
CLEANUP_ALERT_REPEAT_SECONDS=21600

# The systemd unit supplies STATE_DIRECTORY; set this only for manual runs.
# CLEANUP_ALERT_STATE_DIRECTORY=/absolute/private/directory
